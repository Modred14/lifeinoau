{
  "//": "package.json",
  "name": "lifeinoau",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "seed": "node prisma/seed.js",
    "test": "node tests/run-all.mjs",
    "realtime": "node --env-file=.env realtime/server.js",
    "test:chat": "node tests/e2e/chat.e2e.mjs",
    "build:roads": "node tools/oau/dump-merged.mjs /tmp/oau-merged.json && python3 tools/oau/roadgraph.py /tmp/oau-merged.json public/data/oau-roadgraph.json"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "three": "^0.186.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "19.3.0",
    "prisma": "^6.19.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
