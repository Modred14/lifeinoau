+      else {
+        const bits = [...(r.earnedKobo && r.earnedKobo !== "0" ? [`+${naira(r.earnedKobo)}`] : []), ...chips(r.applied), ...(r.score != null ? [r.outOf ? `${r.score}/${r.outOf}` : `score ${r.score}, grade point ${r.gradePoint}`] : [])];
