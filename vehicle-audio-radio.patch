+.th .cr-more { height: 36px; border-radius: 10px; background: transparent; color: #cfd7e8; border: 1px dashed rgba(255, 255, 255, 0.25); }
+.cr-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; max-height: 190px; overflow: auto; }
+.th .cr-list button { width: 100%; min-height: 44px; display: grid; gap: 1px; text-align: left; padding: 7px 12px; border-radius: 12px; background: #131c33; color: #fff; border: 1px solid transparent; }
