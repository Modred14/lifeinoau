+++ b/lib/audio/engineModel.js
@@ -0,0 +1,73 @@
+// lib/audio/engineModel.js
+// What an engine is doing, from how fast the vehicle goes and how hard the driver is on the throttle: its RPM, which gear an automatic gearbox would be in,
+// and how loaded it is. Pure JS (no Web Audio, no DOM): engineVoice.js turns the result into sound and the tests check the behaviour.
+//
+//   - it idles when the vehicle stands, and revs freely (like a torque converter) when you floor it from a standstill,
+//   - in gear the RPM follows the road speed, so the revs climb through each gear and fall at each upshift (the gear changes you hear),
+//   - a gear change takes a moment: the throttle is cut, the revs fall (or blip on a downshift) towards the new gear, then power comes back,
+//   - the RPM has weight: it rises and falls at a limited rate instead of jumping, and never goes above the redline (it bounces off the limiter),
+//   - an electric motor has no gears or idle: its whine rises with speed,
+//   - starting: it cranks, catches, and settles at idle; switching off lets the revs fall away.
+const clamp = (v, a, b) => Math.max(a, Math.min(b, v));
+const SHIFT_S = 0.3;
+
+/** A new engine, switched off. */
+export function createEngine(P) { return { P, mode: "off", t: 0, rpm: 0, gear: 1, shiftT: 0, shiftDir: 0, load: 0, thr: 0, limiter: 0, wob: Math.random() * 6 }; }
+
+/** Turn the key: it cranks for about half a second, catches, flares and settles to idle. */
+export function startEngine(e) { if (e.mode === "run" || e.mode === "crank") return; e.mode = e.P.ev ? "run" : "crank"; e.t = 0; e.gear = 1; e.shiftT = 0; if (e.P.ev) e.rpm = 0; }
+/** Switch off: the revs fall away (the voice fades out as rpm reaches 0). */
+export function stopEngine(e) { if (e.mode !== "off") { e.mode = "stopping"; e.t = 0; } }
+export const isSilent = (e) => e.mode === "off" || (e.mode === "stopping" && e.rpm < 60);
+
+/** The gear for a speed: the lowest one whose top speed is above it (what a gearbox holding revs low would pick). */
+function gearRpm(P, gear, speed) {
+  const top = P.gears[gear - 1], span = (P.red * 0.94 - P.idle);
+  return P.idle + span * clamp(speed / top, 0, 1.12);
+}
+
+/**
+ * Advance one step. in: { speed (m/s, >= 0), throttle (0..1), dt }. Returns the engine, whose rpm, gear, load (0..1) and rpmN (0..1 between idle and redline) are what the sound needs.
+ */
+export function stepEngine(e, { speed = 0, throttle = 0, dt = 1 / 60 }) {
+  const P = e.P; dt = clamp(dt, 0, 0.25); speed = Math.max(0, speed); throttle = clamp(throttle, 0, 1); e.t += dt; e.thr += (throttle - e.thr) * (1 - Math.exp(-dt * 12));
+  if (P.ev) { // a motor: no gears, no idle; the whine follows the speed (with a little extra under load)
+    if (e.mode === "stopping") { e.rpmN = Math.max(0, (e.rpmN ?? 0) - dt * 1.6); e.rpm = e.rpmN * 100; if (e.rpmN <= 0) e.mode = "off"; e.load = 0; return e; }
+    if (e.mode === "off") { e.rpm = 0; e.rpmN = 0; e.load = 0; return e; }
+    const want = clamp(speed / 38, 0, 1) * 0.92 + e.thr * 0.08;
+    e.rpmN = (e.rpmN ?? 0) + (want - (e.rpmN ?? 0)) * (1 - Math.exp(-dt * 7)); e.rpm = e.rpmN * 100; e.load = clamp(0.12 + e.thr * 0.88, 0, 1); e.gear = 1; return e;
+  }
+  const span = P.red - P.idle;
+  if (e.mode === "off") { e.rpm = 0; e.load = 0; e.rpmN = 0; return e; }
+  if (e.mode === "crank") { // the starter turns it over unevenly, then it catches and flares above idle
+    if (e.t < 0.55) { e.rpm = 210 + Math.sin(e.t * 34) * 55 + Math.sin(e.t * 13) * 30; e.load = 0.25; e.rpmN = 0; return e; }
+    if (e.t < 0.75) { e.rpm = clamp(e.rpm + (P.idle * 1.5 - e.rpm) * (1 - Math.exp(-dt * 18)), 0, P.red); e.load = 0.5; e.rpmN = (e.rpm - P.idle) / span; return e; }
+    e.mode = "run";
+  }
+  if (e.mode === "stopping") { e.rpm = Math.max(0, e.rpm - (700 + e.rpm * 2.2) * dt); e.load = 0; e.rpmN = clamp((e.rpm - P.idle) / span, 0, 1); if (e.rpm <= 0) e.mode = "off"; return e; }
+
+  // ---- the gearbox ----
+  const top = P.gears.length, up = P.idle + span * (0.5 + 0.38 * e.thr), down = P.idle + span * (0.17 + 0.06 * e.thr);
+  if (e.shiftT > 0) e.shiftT = Math.max(0, e.shiftT - dt);
+  else if (speed > 0.8) {
+    const r = gearRpm(P, e.gear, speed);
+    if (e.gear < top && r > up) { e.gear++; e.shiftT = SHIFT_S; e.shiftDir = 1; }
+    else if (e.gear > 1 && r < down) { e.gear--; e.shiftT = SHIFT_S * 0.8; e.shiftDir = -1; }
+    else if (e.gear > 1 && e.thr > 0.9 && gearRpm(P, e.gear - 1, speed) < P.red * 0.8) { e.gear--; e.shiftT = SHIFT_S * 0.8; e.shiftDir = -1; }   // kickdown: floor it and it drops a gear
+  } else if (e.gear > 1) { e.gear = 1; e.shiftT = 0; }
+
+  // ---- the revs ----
+  const shifting = e.shiftT > 0, inGear = gearRpm(P, e.gear, speed);
+  let target;
+  if (speed < 1.2) target = P.idle + span * 0.62 * Math.pow(e.thr, 1.2) + (e.thr < 0.04 ? Math.sin((e.wob += dt * 5.5)) * 14 : 0);   // standing: idle, or revving freely
+  else if (shifting) target = e.shiftDir > 0 ? Math.max(P.idle * 1.1, inGear * 0.92) : inGear * 1.05;   // between gears: heading for where the new gear will put it
+  else target = Math.max(inGear, P.idle + span * 0.45 * e.thr * (speed < 5 ? 1 : 0));
+  const rising = target > e.rpm, rate = rising ? 2600 + 7000 * (0.25 + e.thr) : 2400 + e.rpm * 0.9;   // RPM per second: it takes a moment to rev, and a moment to fall
+  e.rpm += clamp(target - e.rpm, -rate * dt, rate * dt);
+  if (e.rpm > P.red * 0.985) { e.limiter = Math.min(1, e.limiter + dt * 8); e.rpm = P.red * 0.985 - e.limiter * 120; } else e.limiter = Math.max(0, e.limiter - dt * 4);   // bounces off the limiter
+  e.rpm = clamp(e.rpm, P.idle * 0.9, P.red);
+  e.rpmN = clamp((e.rpm - P.idle) / span, 0, 1);
+  // load: how hard it is working. A gear change cuts it; coasting in gear (engine braking) is light; throttle on a loaded engine is heavy
+  e.load = clamp((shifting ? 0.12 : 0.1 + 0.9 * e.thr) * (0.75 + 0.25 * e.rpmN), 0, 1);
+  return e;
+}
diff --git a/lib/audio/engineVoice.js b/lib/audio/engineVoice.js
new file mode 100644
index 0000000..c53e3b2
--- /dev/null
+++ b/lib/audio/engineVoice.js
@@ -0,0 +1,69 @@
+// lib/audio/engineVoice.js
+// One engine, as sound. A voice is a small Web Audio graph built from an engine profile (profiles.js) and driven every few frames by the engine model (engineModel.js):
+//
+//   exhaust pulse: two oscillators playing the profile's harmonic stack at the firing frequency (the second a few cents off, so the pair slowly beats, like a real engine)
+//   + a half-order lump (triangle at half the firing rate) + a diesel clatter (the sound pulsing at the firing rate)   ->  a low-pass that opens with throttle and revs
+//   + intake / mechanical noise (band-passed noise that rises with revs)
+//   all of it with a slow random wander in pitch, so no two revolutions are exactly alike: it never sounds like a loop, and there are no samples to repeat.
+//
+// An "exterior" voice (another vehicle) also passes through an air filter (far = muffled) and a panner (placed in the world); your own vehicle's voice goes straight out.
+// A voice is cheap to run (about a dozen nodes; the light version about eight), is created once, and is disposed completely when its vehicle goes.
+import { makePanner, setPannerPos, noiseSource, startNoise, airCutoff, clamp } from "./spatial.js";
+
+const waves = new WeakMap();
+/** The exhaust pulse of a profile: harmonic n with weight n^-tilt (even ones scaled by `even`). Built once per profile per context. */
+function pulseWave(ctx, P) {
+  let m = waves.get(ctx); if (!m) waves.set(ctx, (m = new Map()));
+  let w = m.get(P); if (w) return w;
+  const n = (P.wave?.n ?? 20) + 1, re = new Float32Array(n), im = new Float32Array(n);
+  for (let h = 1; h < n; h++) im[h] = Math.pow(h, -(P.wave?.tilt ?? 1)) * (h % 2 === 0 ? P.wave?.even ?? 0.8 : 1);
+  w = ctx.createPeriodicWave(re, im, { disableNormalization: false }); m.set(P, w); return w;
+}
+
+/**
+ * ctx, dest: where to play. P: an engine profile. opts: { spatial (exterior: panned and filtered by distance), lite (fewer nodes, for phones) }.
+ * Returns { update(s), setPosition(x, y, z), fadeOut(sec), dispose(), alive }.
+ */
+export function createEngineVoice(ctx, dest, P, { spatial = false, lite = false } = {}) {
+  const t0 = ctx.currentTime, all = [], src = [];
+  const node = (n) => (all.push(n), n);
+  const out = node(ctx.createGain()); out.gain.value = 0;
+  let air = null, panner = null;
+  if (spatial) { air = node(ctx.createBiquadFilter()); air.type = "lowpass"; air.frequency.value = 12000; panner = node(makePanner(ctx)); out.connect(air); air.connect(panner); panner.connect(dest); } else out.connect(dest);
+
+  const lp = node(ctx.createBiquadFilter()); lp.type = "lowpass"; lp.Q.value = P.ev ? 2.2 : 0.8; lp.frequency.value = P.cut[0];
+  const am = node(ctx.createGain()); am.gain.value = 1 - (P.knock ?? 0) * 0.5; lp.connect(am); am.connect(out);
+  const wave = pulseWave(ctx, P), f0 = P.ev ? P.fMin : Math.max(8, (P.idle / 60) * P.cyl / 2);
+  const osc = (type, detune = 0) => { const o = node(ctx.createOscillator()); if (type) o.type = type; else o.setPeriodicWave(wave); o.frequency.value = f0; o.detune.value = detune; src.push(o); return o; };
+  const mainOsc = osc(null), g1 = node(ctx.createGain()); g1.gain.value = 0.55; mainOsc.connect(g1); g1.connect(lp);
+  let osc2 = null; if (!lite) { osc2 = osc(null, 7 + Math.random() * 6); const g2 = node(ctx.createGain()); g2.gain.value = 0.38; osc2.connect(g2); g2.connect(lp); }
+  let sub = null; if (P.sub > 0) { sub = osc("triangle"); const gs = node(ctx.createGain()); gs.gain.value = P.sub * 0.55; sub.connect(gs); gs.connect(lp); }
+  let knock = null; if ((P.knock ?? 0) > 0 && !lite) { knock = osc("sine"); const kd = node(ctx.createGain()); kd.gain.value = P.knock * 0.5; knock.connect(kd); kd.connect(am.gain); }
+  // intake and mechanical noise, past the tone filter so it keeps its hiss
+  const ns = node(noiseSource(ctx, 0.9 + Math.random() * 0.2)), bp = node(ctx.createBiquadFilter()), gn = node(ctx.createGain()); bp.type = "bandpass"; bp.Q.value = 0.7; bp.frequency.value = 400; gn.gain.value = 0; ns.connect(bp); bp.connect(gn); gn.connect(out); src.push(ns);
+  for (const s of src) { if (s === ns) startNoise(s); else s.start(t0 + Math.random() * 0.05); }
+
+  let wander = 0, alive = true, last = t0;
+  const api = {
+    get alive() { return alive; },
+    /** s: { rpm, rpmN (0..1), load (0..1), level (0..1: the channel volume and any ducking), dop (pitch ratio), dist (m, exterior only), facing (-1 receding .. 1 approaching) } */
+    update(s) {
+      if (!alive) return; const t = ctx.currentTime, dt = clamp(t - last, 0.005, 0.25); last = t;
+      wander += (Math.random() - 0.5) * (P.jitter ?? 0.004) * 6 - wander * dt * 3; wander = clamp(wander, -(P.jitter ?? 0.004) * 3, (P.jitter ?? 0.004) * 3);   // a slow random drift that pulls back to nothing
+      const rpmN = clamp(s.rpmN ?? 0, 0, 1), load = clamp(s.load ?? 0, 0, 1), dop = s.dop ?? 1;
+      const f = (P.ev ? P.fMin + (P.fMax - P.fMin) * rpmN : (s.rpm / 60) * P.cyl / (P.stroke === 2 ? 1 : 2)) * dop * (1 + wander), tc = 0.035;
+      mainOsc.frequency.setTargetAtTime(f, t, tc); osc2?.frequency.setTargetAtTime(f, t, tc); sub?.frequency.setTargetAtTime(f / 2, t, tc); knock?.frequency.setTargetAtTime(f, t, tc);
+      const open = P.ev ? 0.4 + 0.6 * rpmN : 0.2 + 0.4 * rpmN + 0.4 * load, face = 0.85 + 0.15 * (s.facing ?? 0);
+      lp.frequency.setTargetAtTime((P.cut[0] + (P.cut[1] - P.cut[0]) * open) * face, t, 0.06);
+      const idleG = P.ev ? 0 : 0.34, body = P.ev ? 0.15 + 0.85 * rpmN : idleG + (1 - idleG) * (0.3 * rpmN + 0.7 * load);
+      out.gain.setTargetAtTime((P.gain ?? 0.6) * body * (s.level ?? 1) * (s.rpm < 40 && !P.ev ? 0 : 1), t, 0.05);
+      bp.frequency.setTargetAtTime(350 + 2600 * rpmN, t, 0.08); gn.gain.setTargetAtTime((P.noise ?? 0.1) * (0.25 + 0.75 * load) * (0.4 + 0.6 * rpmN), t, 0.08);
+      if (air) air.frequency.setTargetAtTime(airCutoff(s.dist ?? 0) * (0.8 + 0.2 * (s.facing ?? 0)), t, 0.1);
+    },
+    setPosition(x, y, z) { if (panner) setPannerPos(panner, x, y, z); },
+    /** Let the sound fall away over `sec` seconds, then free everything. */
+    fadeOut(sec = 0.25) { if (!alive) return; alive = false; const t = ctx.currentTime; out.gain.cancelScheduledValues(t); out.gain.setTargetAtTime(0, t, sec / 4); setTimeout(() => api.dispose(true), sec * 1000 + 80); },
+    dispose(already) { if (!already) alive = false; for (const s of src) { try { s.stop(); } catch { /* already stopped */ } } for (const n of all) { try { n.disconnect(); } catch { /* already gone */ } } src.length = all.length = 0; },
+  };
+  return api;
+}
diff --git a/lib/audio/hornBrain.js b/lib/audio/hornBrain.js
new file mode 100644
index 0000000..43772fb
--- /dev/null
+++ b/lib/audio/hornBrain.js
@@ -0,0 +1,54 @@
+// lib/audio/hornBrain.js
+// When a computer-driven vehicle honks. Pure JS. It looks at what is in the way of each vehicle (the thing the traffic simulation says it is following) and decides,
+// like a patient driver: a person standing in the road ahead gets one warning toot as it comes up to them, and more if it is stopped and they do not move; a vehicle that is
+// stopped in front for a long time gets an impatient toot; a vehicle waiting its turn at a junction hardly honks at all. Nobody honks every second:
+//   - one honk, a double or one long honk, then a quiet spell for that vehicle (at least 9 s, and at most 3 honks at one blockage, then 30 s of silence),
+//   - never more than one NPC honk per second anywhere, and none for a vehicle too far away to be heard.
+// consider() is cheap: call it for the vehicles near the listener a few times a second.
+const PERSON = new Set(["ped", "player"]);
+
+/** What a `lead` from the traffic simulation is in the way: "ped" (a walker), "player" (you on foot), "vehicle", or "other" (your own car). */
+export function leadKind(who) {
+  if (!who) return null;
+  if (who.edge !== undefined && who.speed !== undefined) return "ped";   // a simulated pedestrian
+  if (who.kind !== undefined && who.route !== undefined) return "vehicle";
+  if ((who.len ?? 9) < 1) return "player";                              // the player on foot is registered as a 0.6 m box
+  return "other";
+}
+
+export function createHornBrain({ rnd = Math.random, maxHear = 140 } = {}) {
+  const mem = new Map(); let lastAny = -1e9;
+  const get = (id) => { let m = mem.get(id); if (!m) { m = { since: null, last: -1e9, n: 0, quietUntil: 0, warned: false, patience: 0.9 + rnd() * 1.3, wait: 4 + rnd() * 3.5 }; mem.set(id, m); } return m; };
+  return {
+    /**
+     * id: a stable vehicle id. kind: "car"|"keke"|"bus"|"minibus". s: { v: speed m/s, lead: { gap, v, who } | null, waiting: at a junction's stop line, dist: metres from the listener }. now: seconds.
+     * Returns null, or { pattern: "toot"|"double"|"long"|"peep" }.
+     */
+    consider(id, kind, s, now) {
+      if (s.dist > maxHear) return null;
+      const m = get(id), lead = s.lead, lk = lead ? leadKind(lead.who) : null;
+      if (!lead || lead.gap > 15 || lk === "other") { m.since = null; m.warned = false; if (!lead) m.n = 0; return null; }
+      if (now < m.quietUntil || now - lastAny < 1 || now - m.last < 9) return null;
+      const person = PERSON.has(lk), k = kind === "keke" ? 0.7 : kind === "bus" ? 1.4 : 1;
+      const go = (pattern) => { m.last = lastAny = now; m.n++; m.since = now; if (m.n >= 3) { m.quietUntil = now + 30; m.n = 0; } return { pattern: kind === "keke" ? "peep" : kind === "bus" && pattern !== "toot" ? "long" : pattern }; };
+      if (person) {
+        // coming up to someone in the road at speed: one warning toot per encounter
+        if (!m.warned && s.v > 2.5 && lead.gap > 4 && lead.gap < 15 && rnd() < 0.85) { m.warned = true; return go("toot"); }
+        // stopped for them and they are still there
+        if (s.v < 1 && lead.gap < 8) { m.since ??= now; if (now - m.since > m.patience * k) return go(m.n ? "double" : "toot"); }
+        else if (s.v >= 1) m.since = null;
+        return null;
+      }
+      // stopped behind another vehicle that is not moving: impatience, mostly after a long wait, and rarely at a junction where everyone is waiting their turn
+      if (lead.v < 0.3 && s.v < 0.5 && lead.gap < 8) {
+        m.since ??= now; const need = m.wait * k * (s.waiting ? 4 : 1);
+        if (now - m.since > need && rnd() < (s.waiting ? 0.2 : 0.55)) return go(rnd() < 0.3 ? "long" : "toot");
+      } else m.since = null;
+      return null;
+    },
+    forget(id) { mem.delete(id); },
+    /** Drop what is known about vehicles that are no longer there (call with the set of ids alive now). */
+    prune(alive) { for (const id of mem.keys()) if (!alive.has(id)) mem.delete(id); },
+    get size() { return mem.size; },
+  };
+}
diff --git a/lib/audio/hornVoice.js b/lib/audio/hornVoice.js
new file mode 100644
index 0000000..ae57c4d
--- /dev/null
+++ b/lib/audio/hornVoice.js
@@ -0,0 +1,46 @@
+// lib/audio/hornVoice.js
+// Car horns, built from reeds (a pair of buzzing tones a third apart, like a real two-tone horn). Each vehicle category has its own (profiles.js: HORNS).
+//   playHorn()   a honk or a pattern of honks ("toot", "double", "long", "peep"): positional when given a place in the world, then it frees itself
+//   holdHorn()   the player's own horn: sounds for as long as the button is held (never shorter than a real horn's first blast), then lets go
+// Horns are short-lived and capped by the caller (tripAudio keeps at most a few alive), so they cost nothing when nobody is honking.
+import { makePanner, setPannerPos, airCutoff } from "./spatial.js";
+import { PATTERNS } from "./profiles.js";
+
+/** Builds the reeds of horn H into `dest` starting at time t0 (s), lasting `dur`. Returns { oscs, nodes, release(t) }. */
+function reeds(ctx, dest, H, t0, dur, gain, sustain) {
+  const oscs = [], nodes = [], env = ctx.createGain(); nodes.push(env);
+  env.gain.setValueAtTime(0.0001, t0); env.gain.exponentialRampToValueAtTime(Math.max(0.0002, gain), t0 + 0.012);
+  if (!sustain) { env.gain.setValueAtTime(Math.max(0.0002, gain), Math.max(t0 + 0.012, t0 + dur - 0.06)); env.gain.exponentialRampToValueAtTime(0.0001, t0 + dur); }
+  env.connect(dest);
+  for (const T of H.tones) {
+    const o = ctx.createOscillator(), g = ctx.createGain(); o.type = T.type; o.frequency.setValueAtTime(T.f, t0); g.gain.value = T.vol; oscs.push(o); nodes.push(g);
+    let tail = o;
+    if (T.lp) { const f = ctx.createBiquadFilter(); f.type = "lowpass"; f.frequency.value = T.lp; o.connect(f); tail = f; nodes.push(f); }
+    if (T.buzz) { const l = ctx.createOscillator(), d = ctx.createGain(); l.frequency.value = 95; d.gain.value = T.buzz; l.connect(d); d.connect(o.frequency); oscs.push(l); nodes.push(d); }   // the reed's rasp
+    tail.connect(g); g.connect(env);
+  }
+  for (const o of oscs) o.start(t0);
+  return { oscs, nodes, env, stopAt(t) { for (const o of oscs) { try { o.stop(t); } catch { /* already stopped */ } } } };
+}
+const free = (nodes, ms) => setTimeout(() => { for (const n of nodes) { try { n.disconnect(); } catch { /* gone */ } } }, ms);
+
+/**
+ * H: a horn from HORNS. opts: { pattern: "toot"|"double"|"long"|"peep"|"tap", level (0..1), pos: { x, y, z } | null, dist (m; for the muffling of a far horn) }.
+ * Returns { stop() }.
+ */
+export function playHorn(ctx, dest, H, { pattern = "toot", level = 1, pos = null, dist = 0 } = {}) {
+  const beats = PATTERNS[pattern] ?? PATTERNS.toot, t0 = ctx.currentTime + 0.01, nodes = [], stops = [];
+  let sink = dest;
+  if (pos) { const air = ctx.createBiquadFilter(); air.type = "lowpass"; air.frequency.value = airCutoff(dist); const p = makePanner(ctx, { ref: 8, rolloff: 1.1, max: 300 }); setPannerPos(p, pos.x, pos.y ?? 1, pos.z); air.connect(p); p.connect(dest); nodes.push(air, p); sink = air; }
+  let end = t0;
+  for (const [at, len] of beats) { const r = reeds(ctx, sink, H, t0 + at, len, 0.55 * level, false); nodes.push(...r.nodes); r.stopAt(t0 + at + len + 0.05); stops.push(r); end = Math.max(end, t0 + at + len); }
+  const ms = (end - ctx.currentTime) * 1000 + 250; free(nodes, ms);
+  return { stop() { for (const r of stops) { try { r.env.gain.cancelScheduledValues(ctx.currentTime); r.env.gain.setTargetAtTime(0, ctx.currentTime, 0.015); r.stopAt(ctx.currentTime + 0.1); } catch { /* done */ } } } };
+}
+
+/** The player's horn: starts now, sounds until release() (at least `min` seconds, as a real horn is never a click). */
+export function holdHorn(ctx, dest, H, { level = 1, min = 0.16 } = {}) {
+  const t0 = ctx.currentTime + 0.005, r = reeds(ctx, dest, H, t0, 0, 0.55 * level, true); let done = false;
+  const stop = () => { if (done) return; done = true; const t = ctx.currentTime; r.env.gain.cancelScheduledValues(t); r.env.gain.setTargetAtTime(0.0001, t, 0.02); r.stopAt(t + 0.16); free(r.nodes, 400); };
+  return { release() { const wait = Math.max(0, t0 + min - ctx.currentTime); if (wait > 0) setTimeout(stop, wait * 1000); else stop(); }, stop };
+}
diff --git a/lib/audio/mixer.js b/lib/audio/mixer.js
new file mode 100644
index 0000000..303fa8b
--- /dev/null
+++ b/lib/audio/mixer.js
@@ -0,0 +1,53 @@
+// lib/audio/mixer.js
+// The volume knobs for the world's sound (engines, horns, traffic, town, radio) and the master over everything. Plain module state + subscribe, like lib/sound.js,
+// so the audio code, the Settings app and the radio panel all read and write the same store. Pure apart from localStorage (guarded): it also runs in the tests.
+//
+// The SAVED copy of these lives in the player's settings on the server (lib/settings.js: audio.*), applied by lib/prefs.js through applyMixFromPrefs().
+// Changes made from the car (the radio's volume slider) are kept on this device only, the same way the quick mute button is: the Settings screen stays the saved copy.
+import { useSyncExternalStore } from "react";
+
+export const MIX_DEFAULTS = Object.freeze({
+  masterVolume: 100, engineVolume: 100, hornVolume: 100, trafficVolume: 100, townVolume: 100, radioVolume: 80,
+  masterMute: false, engineMute: false, hornMute: false, trafficMute: false, townMute: false,
+  hornStyle: "auto",
+});
+export const HORN_STYLES = ["auto", "standard", "deep", "bright", "air"];
+const KEY = "lifeinoau:mix";
+const pct = (v, d) => (typeof v === "number" && Number.isFinite(v) ? Math.min(100, Math.max(0, Math.round(v))) : d);
+const clean = (j) => {
+  const o = j && typeof j === "object" ? j : {}, out = {};
+  for (const [k, d] of Object.entries(MIX_DEFAULTS)) out[k] = typeof d === "number" ? pct(o[k], d) : typeof d === "boolean" ? (typeof o[k] === "boolean" ? o[k] : d) : HORN_STYLES.includes(o[k]) ? o[k] : d;
+  return Object.freeze(out);
+};
+
+let mix = MIX_DEFAULTS, loaded = false;
+const subs = new Set();
+const emit = () => { for (const f of subs) f(); };
+function load() {
+  if (loaded || typeof window === "undefined") return;
+  loaded = true;
+  try { mix = clean(JSON.parse(localStorage.getItem(KEY) ?? "null")); } catch { mix = MIX_DEFAULTS; }
+}
+export const getMix = () => { load(); return mix; };
+export const subscribeMix = (f) => { subs.add(f); return () => subs.delete(f); };
+export const useMix = () => useSyncExternalStore(subscribeMix, getMix, () => MIX_DEFAULTS);
+
+/** setMix({ radioVolume: 40 }). Saved on this device. */
+export function setMix(patch, { save = true } = {}) {
+  load();
+  const next = clean({ ...mix, ...patch });
+  if (Object.keys(next).every((k) => next[k] === mix[k])) return;
+  mix = next;
+  if (save) { try { localStorage.setItem(KEY, JSON.stringify(mix)); } catch { /* private mode: it just won't be remembered */ } }
+  emit();
+}
+/** The player's saved audio settings (server copy) become the live mix. */
+export function applyMixFromPrefs(audio) { if (audio) setMix(audio, { save: true }); }
+
+/** The level (0..1) of one channel: "master" | "engine" | "horn" | "traffic" | "town" | "radio". Muting the master, or the channel, gives 0. */
+export function channel(name, m = getMix()) {
+  const master = m.masterMute ? 0 : m.masterVolume / 100;
+  if (name === "master") return master;
+  if (name === "radio") return master * (m.radioVolume / 100);
+  return m[name + "Mute"] ? 0 : master * (m[name + "Volume"] / 100);
+}
diff --git a/lib/audio/profiles.js b/lib/audio/profiles.js
new file mode 100644
index 0000000..bd0090d
--- /dev/null
+++ b/lib/audio/profiles.js
@@ -0,0 +1,73 @@
+// lib/audio/profiles.js
+// What every kind of vehicle sounds like, as numbers (pure JS: used by the voices in engineVoice.js / hornVoice.js and by the tests).
+// There are no recordings: each engine is built live from these numbers (a stack of harmonics at the engine's firing frequency, its own lumpiness, intake and exhaust noise),
+// so a keke, a bus, a hatchback and a V10 sound like different machines, and the pitch follows the real RPM.
+//
+//   cyl, stroke   cylinders and 2 or 4 stroke: the engine fires cyl/2 times per turn (4-stroke), so the sound's pitch is rpm/60 * cyl/2
+//   idle, red     idle and redline RPM
+//   gears         the speed (m/s) at the top of each gear, near redline: this is what makes the revs rise and fall with every gear change
+//   wave          the exhaust pulse's harmonics: { n harmonics, tilt (higher = rounder), even (how strong the even ones are) }
+//   cut           the tone's low-pass cutoff [at idle, wide open] in Hz   |   sub: weight of the half-order lump   |   noise: intake and mechanical hiss
+//   knock         diesel clatter: how strongly the sound pulses at the firing rate   |   jitter: cycle-to-cycle wander (keeps it from sounding like a machine)
