+  }
+  const breezeG = gain(0); { const s = noise(0.8), f = bpf(1700, 0.45); s.connect(f); f.connect(breezeG); breezeG.connect(townBus); }
+  const cricketG = gain(0), cricketLfo = []; {
+    for (const [fr, lfoHz] of [[4300, 11], [5100, 14.3]]) { const o = node(ctx.createOscillator()), env = gain(0), l = node(ctx.createOscillator()), d = gain(0.5), off = node(ctx.createConstantSource()); o.frequency.value = fr; l.type = "square"; l.frequency.value = lfoHz * (0.97 + Math.random() * 0.06); off.offset.value = 0.5; l.connect(d); d.connect(env.gain); off.connect(env.gain); const f = bpf(fr, 14); o.connect(f); f.connect(env); env.connect(cricketG); src.push(o, l, off); cricketLfo.push(l); }
