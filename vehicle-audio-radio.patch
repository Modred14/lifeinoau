+.cr-chip span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+/* a phone on its side has hardly any height: the panel shrinks to the essentials, the station list scrolls */
+@media (max-height: 480px) { .th .cr { top: calc(var(--th-top) + 8px); left: calc(var(--th-l) + var(--th-info-w) + 8px); width: min(300px, calc(100vw - var(--th-l) - var(--th-info-w) - var(--th-mini) - 40px)); max-height: calc(100dvh - var(--th-top) - 14px); gap: 6px; padding: 9px; } .cr-list { max-height: 110px; } .th .cr-chip { top: calc(var(--th-top) + 74px); } }
+@media (prefers-reduced-motion: reduce) { .cr-eq[data-live="1"] b, .cr-spin { animation: none; } .cr-eq[data-live="1"] b { height: 70%; } }
