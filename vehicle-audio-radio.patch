+      o.type = "sawtooth"; const base = f0 * (kind === "call" ? 1.1 + i * 0.12 : 1 + rnd(-0.12, 0.12)); o.frequency.setValueAtTime(base, t); o.frequency.linearRampToValueAtTime(base * (kind === "call" ? 1.18 : 1 + rnd(-0.08, 0.08)), t + dur);
