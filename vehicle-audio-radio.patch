diff --git a/components/car-radio.css b/components/car-radio.css
new file mode 100644
index 0000000..c89bde1
--- /dev/null
+++ b/components/car-radio.css
@@ -0,0 +1,54 @@
+/* components/car-radio.css: the car radio (components/CarRadio.js). Uses the trip HUD's colours (--th-*, set in travel.css) and sits top left under the trip card, so the road
+   ahead, the vehicle and the pedals are never covered. Flat colours. Touch targets are at least 44px on phones. */
+.th .th-radio { width: var(--th-aux); height: var(--th-aux); min-height: 0; padding: 0; border-radius: 50%; background: var(--th-surface); color: #fff; border: 1px solid var(--th-line); box-shadow: none; display: grid; place-items: center; }
+.th .th-radio:hover:not(:disabled) { background: #1d2a47; border-color: rgba(255, 255, 255, 0.3); }
+.th .th-radio[data-on="1"] { color: #06210f; background: var(--th-ok); border-color: var(--th-ok); }
+.th .th-radio-float { position: absolute; right: var(--th-r); bottom: calc(var(--th-bottom) + 6px); } /* riding (not steering): there is no pedal row, so it sits in the corner */
+
+.th .cr, .th .cr-chip { position: absolute; left: var(--th-l); z-index: 3; }
+.th .cr { top: calc(var(--th-top) + 104px); width: min(320px, calc(100vw - var(--th-l) - 112px)); min-width: 236px; max-height: calc(100dvh - var(--th-top) - var(--th-bottom) - 120px); overflow: auto; overscroll-behavior: contain; box-sizing: border-box; display: grid; gap: 10px; padding: 12px; border-radius: 18px; background: var(--th-surface); border: 1px solid var(--th-line); color: #fff; box-shadow: 0 16px 36px -14px rgba(0, 0, 0, 0.7); }
+.cr header { display: flex; align-items: center; gap: 10px; }
+.cr header b { flex: 1; font: 700 0.9rem/1 var(--font-ui); letter-spacing: 0.02em; }
+.th .cr button { min-height: 0; font: inherit; }
+.th .cr-pw, .th .cr-x { width: 36px; height: 36px; padding: 0; border-radius: 50%; display: grid; place-items: center; background: #1b2540; color: #fff; border: 1px solid var(--th-line); }
+.th .cr-pw[data-on="1"] { background: var(--th-ok); color: #06210f; border-color: var(--th-ok); }
+.th .cr-x { background: transparent; border-color: transparent; }
+.cr-screen { display: flex; align-items: center; gap: 12px; padding: 10px 12px; border-radius: 12px; background: #070c18; border: 1px solid rgba(255, 255, 255, 0.1); min-height: 52px; }
+.cr-screen[data-on="1"] { border-color: rgba(63, 208, 138, 0.45); }
+.cr-txt { min-width: 0; flex: 1; display: grid; gap: 3px; }
+.cr-txt b { font: 700 0.98rem/1.2 var(--font-ui); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.cr-txt span { font-size: 0.8rem; color: #8fe9b8; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.cr-screen:not([data-on="1"]) .cr-txt span { color: #8b96ad; }
+/* the little level bars: still when off or connecting, moving while it plays (not for people who asked for less motion) */
+.cr-eq { display: inline-flex; align-items: flex-end; gap: 2px; height: 18px; flex: none; }
+.cr-eq b { display: block; width: 3px; height: 30%; border-radius: 2px; background: #5a6683; }
+.cr-eq[data-live="1"] b { background: var(--th-ok); animation: cr-bar 0.9s ease-in-out infinite; }
+.cr-eq[data-live="1"] b:nth-child(2) { animation-delay: -0.3s; } .cr-eq[data-live="1"] b:nth-child(3) { animation-delay: -0.6s; } .cr-eq[data-live="1"] b:nth-child(4) { animation-delay: -0.15s; }
